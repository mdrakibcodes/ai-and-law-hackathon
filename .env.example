# Copy this file to .env and fill both in. .env is gitignored.

# https://urlscan.io/user/profile/ — free after signup
URLSCAN_KEY=

# https://console.anthropic.com/settings/keys — starts with sk-ant-
ANTHROPIC_API_KEY=

# Only needed if your Anthropic key is organisation-scoped / identity-linked
# (the API then returns "anthropic-workspace-id is required"). Find it at
# https://console.anthropic.com/settings/workspaces — starts with wrkspc_
ANTHROPIC_WORKSPACE_ID=
